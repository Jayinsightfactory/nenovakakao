{
  "manifest_version": 3,
  "name": "네노바 불량 승인 연결",
  "version": "1.0.0",
  "description": "담당자 승인 건만 현재 로그인 세션으로 영업입력 저장",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://nenovaweb.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "네노바 매크로 연결 (OFF일 때 클릭)"
  },
  "content_scripts": [
    {
      "matches": [
        "https://nenovaweb.com/sales/defect-deductions*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}